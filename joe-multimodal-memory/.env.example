# ==============================================================================
# SAHAYAK — Joe's Multimodal + Memory Module
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ==============================================================================

# 1. Anthropic API Key (Required for live Claude Vision + memory calls)
# Get your API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Choose Claude model (defaults to claude-3-5-sonnet-20241022)
# Vision-capable models: claude-3-5-sonnet-20241022, claude-3-opus-20240229
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 2. Google Gemini API Key (Optional — only used for Part A cross-LLM comparison)
# Get a free key from: https://aistudio.google.com/app/apikey
# If not provided, the comparison section uses documented simulation output.
GOOGLE_API_KEY=your_google_api_key_here

# NOTE: No additional API keys are needed.
# - Part B (infographic) uses only Claude
# - Part C (memory/syllabus) uses only Claude
# - Sample data files are auto-generated by generate_sample_data.py
