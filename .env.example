# ==============================================================================
# SAHAYAK — Unified Environment Configuration Template
# ==============================================================================

# 1. Google Gemini API Key (Default & Primary LLM Provider)
# Get your API key from Google AI Studio:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 2. Anthropic Claude API Key (Alternative / Fallback)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 3. OpenWeatherMap API Key (Live weather lookup)
# https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your_openweather_api_key_here

# 4. Wikipedia REST API (search_topic_summary)
# No API key required!
