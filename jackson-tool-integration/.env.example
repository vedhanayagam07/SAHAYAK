# ==============================================================================
# SAHAYAK - Environment Configuration Template
# ==============================================================================

# 1. Anthropic API Key (Required for live Claude tool-use execution)
# Get your API key from the Anthropic Console:
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Choose Claude model (defaults to claude-3-5-sonnet-20241022)
# Other choices: claude-3-7-sonnet-20250219, claude-3-haiku-20240307
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 2. OpenWeatherMap API Key (Required for get_weather tool)
# Get a free API key from OpenWeatherMap:
# https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your_openweather_api_key_here

# 3. Wikipedia API (search_topic_summary)
# No API key required! Uses the public Wikipedia REST API:
# https://en.wikipedia.org/api/rest_v1/
